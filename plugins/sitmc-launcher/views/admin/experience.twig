{% extends 'admin.base' %}
{% block title %}{{ brandLabel }} · 页面与活动{% endblock %}
{% block content %}
{% include 'sitmc-launcher::admin.distribution-nav' with {activeTab: 'experience'} %}
{% if status %}<div class="callout callout-success">{{ status }}</div>{% endif %}
{% for error in errors.all() %}<div class="callout callout-danger">{{ error }}</div>{% endfor %}
<form method="post" action="{{ route(adminRoutePrefix ~ 'experience.save') }}" id="launcher-experience">
  {{ csrf_field() }}
  <input type="hidden" name="revision" value="{{ document.revision }}">
  <div class="card"><div class="card-body">
    <h3>导航页签</h3>
    <p class="text-muted">控制启动器侧栏显示的入口。网页入口可以单独启停；首页部件的位置由玩家自己调整。</p>
    {% for key, label in navigationLabels %}
      {% if distributionBrand != 'mutmc' or key != 'partners' %}
      <label class="mr-4"><input type="hidden" name="navigation[{{ key }}]" value="0"><input type="checkbox" name="navigation[{{ key }}]" value="1" {{ document.navigation[key] ? 'checked' : '' }}> {{ label }}</label>
      {% endif %}
    {% endfor %}
  </div></div>
  {% for section, title in {pages: '在线地图与网页入口', activities: '社团活动与线下打卡排期'} %}
  <div class="card"><div class="card-body">
    <h3>{{ title }}</h3>
    <p class="text-muted">{% if section == 'pages' %}填写 HTTPS 网址。地图集中显示在“在线地图”内，其他网页各自显示为侧栏页签。目标网站须允许嵌入。{% else %}时间按北京时间填写。可发布公告、活动和线下打卡排期；详情链接可指向活动说明或报名页面。{% endif %}</p>
    <div data-rows="{{ section }}">
      {% for row in document[section] %}{% include 'sitmc-launcher::admin.experience-row' with {section: section, index: loop.index0, row: row} %}{% endfor %}
    </div>
    <button type="button" class="btn btn-default" data-add="{{ section }}">＋ 添加</button>
    <template data-template="{{ section }}">{% include 'sitmc-launcher::admin.experience-row' with {section: section, index: '__INDEX__', row: {id: '__ID__', enabled: true, kind: section == 'pages' ? 'map' : 'event'}} %}</template>
  </div></div>
  {% endfor %}
  <button class="btn btn-primary" type="submit">保存配置</button>
</form>
<script src="{{ asset('plugins/sitmc-launcher/assets/experience.js') }}" defer></script>
{% endblock %}
