{% extends 'admin.base' %}

{% block title %}{{ trans('Blessing\\RestrictedEmailDomains::general.title') }}{% endblock %}

{% block content %}
  <div class="callout callout-info">
    {{ trans('Blessing\\RestrictedEmailDomains::general.notice') }}
  </div>
  <div id="config" class="row">
    {% for kind, domains in {allow: allow, deny: deny} %}
      <div class="col-lg-6">
        <form class="card card-{{ kind == 'allow' ? 'success' : 'danger' }}" data-domain-form action="{{ url('admin/restricted-email-domains/' ~ kind) }}">
          <div class="card-header"><h3 class="card-title">{{ trans('Blessing\\RestrictedEmailDomains::front-end.' ~ kind ~ '.title') }}</h3></div>
          <div class="card-body">
            <input type="hidden" name="_token" value="{{ csrf_token() }}">
            <textarea class="form-control" rows="8" name="domains" placeholder="qq.com&#10;ysu.edu.cn" aria-label="{{ trans('Blessing\\RestrictedEmailDomains::front-end.' ~ kind ~ '.title') }}">{{ domains|join('\n') }}</textarea>
            <div class="alert mt-3" data-domain-message hidden></div>
          </div>
          <div class="card-footer"><button class="btn btn-primary float-right" type="submit">{{ trans('general.submit') }}</button></div>
        </form>
      </div>
    {% endfor %}
  </div>
{% endblock %}
