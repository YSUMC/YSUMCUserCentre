[Unit]
Description=YSUMC game account authorization (Janus)
After=network.target docker.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/ysumcusercentre/janus
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
