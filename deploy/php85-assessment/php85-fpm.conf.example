[global]
pid = /run/ysumc-php85/php-fpm.pid
error_log = /proc/self/fd/2
daemonize = no

[ysumc]
user = www
group = www
listen = /run/ysumc-php85/php-fpm.sock
listen.owner = www
listen.group = www
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 10s
pm.max_requests = 500
clear_env = yes
catch_workers_output = yes
request_terminate_timeout = 90s
security.limit_extensions = .php
