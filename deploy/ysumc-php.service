[Unit]
Description=YSUMC Skin Center PHP-FPM
After=network.target docker.service

[Service]
Type=simple
ExecStart=/www/server/php/81/sbin/php-fpm --nodaemonize --fpm-config /data/program/ysumcusercentre/deploy/php-fpm.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/program/ysumcusercentre/storage
ReadWritePaths=/data/program/ysumcusercentre/bootstrap/cache
ReadWritePaths=/data/program/ysumcusercentre/plugins
ReadWritePaths=/data/program/ysumcusercentre/public/plugins
ReadWritePaths=/data/program/ysumcusercentre/public/lang
UMask=0027

[Install]
WantedBy=multi-user.target
