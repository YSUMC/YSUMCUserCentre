{
  "name": "bs-community/blessing-skin-server",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "license": "MIT",
  "require": {
    "php": "~8.5.0",
    "ext-ctype": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "blessing/filter": "^1.0",
    "blessing/rejection": "^1.0",
    "blessing/texture-renderer": "^0.2",
    "composer/ca-bundle": "^1.2",
    "composer/semver": "^3.2",
    "doctrine/inflector": "^2.0",
    "gregwar/captcha": "^2.1",
    "guzzlehttp/guzzle": "^7.0",
    "intervention/image": "^2.7",
    "laravel/framework": "^13.0",
    "laravel/passport": "^13.0",
    "lorisleiva/laravel-search-string": "1.3.1",
    "nesbot/carbon": "^3.8",
    "nunomaduro/collision": "^8.9",
    "rcrowe/twigbridge": "^0.14.8",
    "spatie/laravel-translation-loader": "^2.6",
    "symfony/process": "^8.0",
    "symfony/yaml": "^8.0",
    "twig/twig": "^3.21",
    "vectorface/whip": "^0.5",
    "lcobucci/jwt": "^5.5",
    "lcobucci/clock": "^3.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.5",
    "symfony/css-selector": "^8.0",
    "symfony/dom-crawler": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.5.12"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/socialite"
      ]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "composer",
      "url": "https://repo.packagist.org"
    }
  ]
}
